{
    "elements":
    [
        { "type": "ValidationTextBox", "name": "IPAddress", "caption": "IP-Address" },
        {
            "type": "Select",
            "name": "Protocol",
            "caption": "Protocol",
            "options": [
                { "caption": "HTTP", "value": "http" },
                { "caption": "HTTPS", "value": "https" }
            ]
        },
        { "type": "NumberSpinner", "name": "Port", "caption": "Port" },
        { "type": "NumberSpinner", "name": "Timeout", "caption": "Timeout"},
        { "type": "IntervalBox", "name": "Interval", "caption": "Sec." },
        { "type": "ValidationTextBox", "name": "Username", "caption": "Username" },
        { "type": "PasswordTextBox", "name": "Password", "caption": "Password"},
        { "type": "CheckBox", "name": "Debug", "caption": "Debug" },
        { "type": "Label", "name": "TlsCertificateStatus", "caption": "HTTPS uses the Symcon trust store" },
        {
            "type": "ExpansionPanel",
            "caption": "Edit PEM manually",
            "expanded": false,
            "items": [
                {
                    "type": "ValidationTextBox",
                    "name": "TlsCertificate",
                    "caption": "HTTPS certificate (PEM, optional)",
                    "multiline": true,
                    "width": "100%",
                    "validate": "^\\s*(?:-----BEGIN CERTIFICATE-----[\\sA-Za-z0-9+/=]+-----END CERTIFICATE-----\\s*)*$"
                }
            ]
        }
    ],
    "actions":
    [
        { "type": "Button", "label": "Sync Data", "onClick": "BlueIrisGateway_SyncData($id);" },
        {
            "type": "PopupButton",
            "caption": "Import HTTPS certificate",
            "popup": {
                "caption": "Import HTTPS certificate",
                "items": [
                    { "type": "Label", "caption": "Choose a public PEM certificate. Import replaces the certificate for this gateway." },
                    { "type": "SelectFile", "name": "TlsCertificateFile", "caption": "PEM certificate file", "extensions": ".pem,.crt,.cer" }
                ],
                "buttons": [
                    { "caption": "Import", "onClick": "echo BlueIrisGateway_ImportTlsCertificate($id, $TlsCertificateFile ?? '');" }
                ]
            }
        }
    ],
    "status":
    [
        { "code": 102, "icon": "active", "caption": "Connection Success!" },
        { "code": 201, "icon": "error", "caption": "Error Invalid parameter" },
        { "code": 203, "icon": "error", "caption": "Internal Error!" },
        { "code": 204, "icon": "error", "caption": "Timeout!" },
        { "code": 205, "icon": "error", "caption": "Wrong Login!" },
        { "code": 206, "icon": "error", "caption": "HTTPS or certificate error" }
    ]
}
